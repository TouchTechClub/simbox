{
  "name": "simbox",
  "version": "0.1.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "typescript": "^5.6.0",
      "@cloudflare/workers-types": "^4.20250913.0",
      "better-auth": "1.7.5",
      "drizzle-orm": "1.0.0-rc.4",
      "react": "^18.3.1",
      "react-dom": "^18.3.1"
    }
  },
  "type": "module",
  "scripts": {
    "typecheck": "for d in packages/shared packages/db packages/agent apps/api apps/cli apps/web; do echo \"── $d\"; (bun run --cwd $d typecheck) || exit 1; done",
    "check": "oxlint && oxfmt --check",
    "check:fix": "oxlint --fix && oxfmt --write",
    "db:generate": "bun run --cwd packages/db db:generate",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:web": "bun run --cwd apps/web dev",
    "build:agent": "bun run --cwd packages/agent build",
    "deploy": "bun run --cwd packages/infra deploy",
    "destroy": "bun run --cwd packages/infra destroy"
  },
  "devDependencies": {
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.14"
}
