# simbox composite action — RENDERED from this template by release.sh.
# Do not edit action.yml directly; edit this file and run ./release.sh to
# re-render with the sha256 of the release tarball.
name: simbox
description: Boot agent-device proxy + cloudflared tunnel on this macOS runner and register it with the simbox API.
branding:
  icon: box
  color: purple
inputs:
  warm_ios:
    description: Optional best-effort iOS prewarming. Leave false for Android-only runs.
    required: false
    default: "false"
  token:
    description: SIMBOX_TOKEN repo secret, provisioned by simbox init.
    required: true
  api_url:
    description: simbox API base URL (override for staging).
    required: false
    default: "https://api.simbox.touchtech.club"
  version:
    description: Release tag of the simbox-agent tarball to download.
    required: false
    default: "v1"
runs:
  using: composite
  steps:
    - name: Run simbox-agent
      shell: bash
      env:
        SIMBOX_WARM_IOS: ${{ inputs.warm_ios }}
        SIMBOX_TOKEN: ${{ inputs.token }}
        SIMBOX_API_URL: ${{ inputs.api_url }}
      run: |
        set -euo pipefail
        TARBALL=simbox-agent-darwin-arm64.tar.gz
        curl -fsSL "https://github.com/TouchTechClub/simbox/releases/download/${{ inputs.version }}/$TARBALL" -o "$TARBALL"
        echo "{{SHA256}}  $TARBALL" | shasum -a 256 -c -
        tar xzf "$TARBALL"
        chmod +x ./simbox-agent
        ./simbox-agent
