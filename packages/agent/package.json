{
  "name": "@simbox/agent",
  "version": "0.1.0",
  "description": "simbox-agent — in-runner agent that boots agent-device proxy + cloudflared tunnel on a GitHub Actions macOS runner",
  "type": "module",
  "scripts": {
    "build": "bun build --compile --target=bun-darwin-arm64 --minify src/index.ts --outfile dist/simbox-agent-darwin-arm64",
    "typecheck": "tsc --noEmit",
    "start": "bun src/index.ts"
  },
  "dependencies": {
    "@simbox/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "bun-types": "^1.3.0",
    "typescript": "catalog:"
  }
}
